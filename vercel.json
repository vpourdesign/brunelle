{
  "buildCommand": "node build.mjs",
  "framework": null,
  "outputDirectory": "site",
  "installCommand": "echo skip",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/vendre/commission-courtier/",
      "destination": "/vendre/evaluation-gratuite/",
      "permanent": true
    },
    {
      "source": "/en/vendre/commission-courtier/",
      "destination": "/en/vendre/evaluation-gratuite/",
      "permanent": true
    },
    {
      "source": "/fr/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/index/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/temoignages/",
      "destination": "/temoignages/",
      "permanent": true
    },
    {
      "source": "/fr/achat-vente/",
      "destination": "/acheter/etapes-pour-acheter/",
      "permanent": true
    },
    {
      "source": "/fr/outils/",
      "destination": "/acheter/calculatrices/",
      "permanent": true
    },
    {
      "source": "/fr/outils/calculatrice-hypothecaire/",
      "destination": "/acheter/calculatrices/",
      "permanent": true
    },
    {
      "source": "/fr/outils/evaluation-immobiliere/",
      "destination": "/vendre/evaluation-gratuite/",
      "permanent": true
    },
    {
      "source": "/fr/outils/alerte-immobiliere/",
      "destination": "/nos-proprietes/",
      "permanent": true
    },
    {
      "source": "/fr/politique-confidentialite/",
      "destination": "/politique-confidentialite/",
      "permanent": true
    },
    {
      "source": "/fr/conditions-d-utilisation/",
      "destination": "/conditions-utilisation/",
      "permanent": true
    },
    {
      "source": "/fr/mes-proprietes/",
      "destination": "/nos-proprietes/",
      "permanent": true
    },
    {
      "source": "/fr/articles/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/fr/articles/:path*/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/fr/nos-proprietes/:path*/",
      "destination": "/nos-proprietes/",
      "permanent": true
    },
    {
      "source": "/en/index/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/achat-vente/",
      "destination": "/en/acheter/etapes-pour-acheter/",
      "permanent": true
